{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "open-ports-menu",
  "title": "Open Ports Menu",
  "description": "Shows listening TCP ports in the macOS menu bar.",
  "icon": "icon.png",
  "author": "lyohe",
  "license": "MIT",
  "platforms": ["macOS"],
  "categories": ["Developer Tools", "System"],
  "commands": [
    {
      "name": "open-ports-menu",
      "title": "Open Ports Menu",
      "description": "Shows listening TCP ports in the macOS menu bar.",
      "mode": "menu-bar",
      "interval": "1m",
      "disabledByDefault": true
    }
  ],
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint"
  },
  "dependencies": {
    "@raycast/api": "latest"
  },
  "devDependencies": {
    "@raycast/eslint-config": "latest",
    "@types/node": "latest",
    "eslint": "latest",
    "prettier": "latest",
    "typescript": "latest"
  }
}
